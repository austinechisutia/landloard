generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model HouseType {
  id         Int       @id @default(autoincrement())
  name       String
  rentAmount Decimal   @db.Decimal(10, 2)
  units      Unit[]
  tenants    Tenant[]
  createdAt  DateTime  @default(now())
}

enum UnitStatus {
  VACANT
  OCCUPIED
}

model Unit {
  id          Int        @id @default(autoincrement())
  name        String
  status      UnitStatus @default(VACANT)
  houseTypeId Int
  houseType   HouseType  @relation(fields: [houseTypeId], references: [id])
  tenants     Tenant[]
  payments    Payment[]
  createdAt   DateTime   @default(now())
}

model Tenant {
  id          Int       @id @default(autoincrement())
  name        String
  phone       String
  houseTypeId Int
  houseType   HouseType @relation(fields: [houseTypeId], references: [id])
  unitId      Int
  unit        Unit      @relation(fields: [unitId], references: [id])
  moveInDate  DateTime
  payments    Payment[]
  createdAt   DateTime  @default(now())
}

enum PaymentStatus {
  PAID
  PENDING
}

enum PaymentType {
  DEPOSIT
  RENT
}

model Payment {
  id          Int              @id @default(autoincrement())
  tenantId    Int
  tenant      Tenant           @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  unitId      Int
  unit        Unit             @relation(fields: [unitId], references: [id])
  paymentType PaymentType      @default(RENT)
  period      DateTime?
  rentAmount  Decimal          @db.Decimal(10, 2) @default(0)
  amountDue   Decimal          @db.Decimal(10, 2)
  amountPaid  Decimal          @db.Decimal(10, 2) @default(0)
  balance     Decimal          @db.Decimal(10, 2)
  status      PaymentStatus    @default(PENDING)
  dueDate     DateTime
  paymentDate DateTime?
  services    PaymentService[]
  createdAt   DateTime         @default(now())
}

enum ServiceType {
  FIXED
  PER_UNIT
}

model Service {
  id        Int              @id @default(autoincrement())
  name      String
  type      ServiceType      @default(FIXED)
  unitPrice Decimal          @db.Decimal(10, 2)
  unitLabel String?
  active    Boolean          @default(true)
  charges   PaymentService[]
  createdAt DateTime         @default(now())
}

model PaymentService {
  id        Int     @id @default(autoincrement())
  paymentId Int
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  serviceId Int
  service   Service @relation(fields: [serviceId], references: [id])
  units     Decimal? @db.Decimal(10, 2)
  amount    Decimal  @db.Decimal(10, 2)
}
